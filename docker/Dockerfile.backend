# GroundedOps backend — FastAPI + sentence-transformer models
FROM python:3.11-slim

WORKDIR /app

# System deps kept minimal; add build-essential only if a wheel needs it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

# Python deps first (layer cache). Installs the audited lock, not a fresh resolve; every file is checked against its hash.
COPY requirements.lock .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --require-hashes -r requirements.lock

# Bake every pinned model (src/model_pins.py) INTO the image at its pinned
# commit, so first run is instant and the container fetches nothing at run
# time (HF_HUB_OFFLINE=1 below): a missing model fails loudly at load.
ENV HF_HOME=/root/.cache/huggingface
COPY model_pins.py .
RUN python -c "from model_pins import REVISIONS as R; from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('Alibaba-NLP/gte-modernbert-base', revision=R['Alibaba-NLP/gte-modernbert-base']); [CrossEncoder(n, revision=R[n]) for n in ('cross-encoder/ms-marco-MiniLM-L-6-v2', 'BAAI/bge-reranker-base', 'cross-encoder/nli-deberta-v3-small')]"
# The embedder runs on ONNX by default (embeddings.EMBED_BACKEND): bake its
# 0.6 GB export too, or the offline image falls back to PyTorch.
RUN python -c "from model_pins import REVISIONS as R; from huggingface_hub import hf_hub_download; hf_hub_download('Alibaba-NLP/gte-modernbert-base', 'onnx/model.onnx', revision=R['Alibaba-NLP/gte-modernbert-base'])"

# Faster CPU checker (NLI_BACKEND=onnx at run time): build with
# --build-arg NLI_BACKEND=onnx to bake its 0.57 GB file in. Without it the
# image is offline, so NLI_BACKEND=onnx falls back to PyTorch.
ARG NLI_BACKEND=
RUN if [ "$NLI_BACKEND" = "onnx" ]; then python -c "from model_pins import REVISIONS as R; from huggingface_hub import hf_hub_download; hf_hub_download('cross-encoder/nli-deberta-v3-small', 'onnx/model.onnx', revision=R['cross-encoder/nli-deberta-v3-small'])"; fi

COPY . .

# chroma_db and uploads live on mounted volumes (see compose)
ENV CHROMA_DIR=/data/chroma_db \
    OLLAMA_URL=http://ollama:11434/api/generate \
    GENERATION_MODE=api \
    HF_HUB_OFFLINE=1

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fs http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
