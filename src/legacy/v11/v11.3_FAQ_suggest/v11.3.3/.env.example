# GroundedOps — environment template
# Copy to .env and fill in. Never commit .env (it's gitignored).
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────

# Gates every admin endpoint (upload, FAQ editing, delete). CHANGE THIS.
ADMIN_PASSWORD=change-me

# "api"   = answers from a cloud provider (fast, needs a key below)
# "local" = fully offline via Ollama (private, slower, needs ~8GB RAM)
GENERATION_MODE=api

# Which provider when GENERATION_MODE=api: deepseek | openai | anthropic
ONLINE_PROVIDER=deepseek

# Provider key. Only the one matching ONLINE_PROVIDER is needed.
# In api mode the SERVER needs this — the widget never holds a key.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# MODELS
# ─────────────────────────────────────────────────────────────────────
# NOTE: DeepSeek retired the "deepseek-chat" alias on 24 July 2026 —
# calls to it are no longer routed. Use a current model name.
ONLINE_DEEPSEEK_MODEL=deepseek-v4-flash
ONLINE_OPENAI_MODEL=gpt-4o-mini
ONLINE_ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────
# WIDGET / CORS
# ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
# "*" is fine for local testing. Set real domains before public use.
WIDGET_ALLOWED_ORIGINS=*

# Host port for the backend API (the widget calls this directly).
BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────────────
# STORAGE  (paths inside the container; keep them on /data so they
#           survive rebuilds via the grounded-data volume)
# ─────────────────────────────────────────────────────────────────────
CHROMA_DIR=/data/chroma_db
CONVO_DB_PATH=/data/conversations.db
SOURCE_FILE_DIR=/data/source_files
FAQ_STORE_PATH=/data/faq_store.json
FAQ_GAP_PATH=/data/faq_gaps.json
CORPUS_DIR=/app/corpus

# Documents hidden from answering (internal specs). Comma-separated
# substrings of filenames. Set to "" to expose everything.
EXCLUDED_SOURCES=icu_network_api

# ─────────────────────────────────────────────────────────────────────
# TUNING — sensible defaults; change only with a reason
# ─────────────────────────────────────────────────────────────────────

# FAQ short-circuit. "off" sends every question through retrieval.
FAQ_ENABLED=on

# Serve a curated answer without asking, only on a near-verbatim match.
FAQ_AUTO_SERVE=0.95

# Floors for offering "these FAQs match your query". Below these the
# question goes to retrieval instead. Lower = more suggestions (and more
# irrelevant ones); higher = fewer.
FAQ_CANDIDATE_FLOOR=0.70
FAQ_CANDIDATE_LEX_FLOOR=0.70

# Drop candidates this far below the best match, so one strong result
# isn't padded out with weak ones.
FAQ_CANDIDATE_MARGIN=0.12
FAQ_MAX_CANDIDATES=3

# Relative score floor for including a chunk as answering context.
CONTEXT_FLOOR_RATIO=0.5

# Use an API model to grade eval runs (much faster than local).
EVAL_GRADER_PROVIDER=local
