# GroundedOps — deployment environment
#
# Copy to `docker/.env` (same directory as docker-compose.yml, which reads it
# automatically) and fill in. `docker/.env` is gitignored; this file is not,
# so never put a real secret in here.
#
#   cp .env.example .env
#
# Everything with a value below is a sane default. Everything marked REQUIRED
# has no default and compose will refuse to start without it — deliberately,
# because a silent default for a signing key is worse than a failed boot.


# ── REQUIRED ───────────────────────────────────────────────────────────

# Signs admin console session tokens. Without it, sign-in refuses everyone.
#   openssl rand -hex 32
SESSION_SECRET=

# Shared with the WordPress plugin's GROUNDEDOPS_SECRET (wp-config.php).
# The widget's signed-in tier depends on both sides holding the same value.
# USE A DIFFERENT VALUE ON STAGING THAN PRODUCTION — a leaked staging secret
# must not mint valid production tokens.
#   openssl rand -hex 32
WIDGET_TOKEN_SECRET=

# At least one provider key, or nothing can answer. Can also be pasted in
# later from the console's API keys page (root only) without a restart.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── Who can reach the admin console ────────────────────────────────────

# EMPTY = the console is LAN-only, which is how this has always worked and
# is still the safest answer. Any request arriving through a proxy is
# refused for every path except /widget/* and /health.
#
# For internal staging, list the IP prefixes that may reach it. Prefix
# match, not CIDR:
#   ADMIN_ALLOWED_IPS=203.0.113.,198.51.100.42
#
# This is an allowlist in FRONT of authentication, not instead of it — a
# request from an allowed address still has to sign in.
ADMIN_ALLOWED_IPS=

# Needed ONCE, and only if you want to create the first root account over
# the network. Leave empty and do it on the box instead, which needs no
# token and no exposed setup endpoint:
#   docker compose exec backend python manage_accounts.py create \
#       you@company.com --level root
#
# If set, POST /admin/auth/bootstrap requires it in an X-Bootstrap-Token
# header. Clear it again once the root account exists.
#   openssl rand -hex 16
BOOTSTRAP_TOKEN=

# Restrict which email domain accounts may be created for. Empty = any.
ALLOWED_EMAIL_DOMAIN=

# How long a console sign-in lasts. 12h default.
SESSION_TTL_SECONDS=43200


# ── Behind a reverse proxy ──────────────────────────────────────────────

# Honour X-Forwarded-For, so per-IP quotas and ADMIN_ALLOWED_IPS see the
# real caller rather than the proxy. ONLY set this when a proxy you control
# is in front: if the app is ever reachable directly, a client can forge the
# header and mint unlimited anonymous identities.
TRUST_PROXY=1

# Ask browsers to stay on HTTPS. TLS itself terminates at the proxy — this
# app does not serve TLS.
ENABLE_HSTS=1

# Origins allowed to call the widget API from a browser. The widget runs on
# a THIRD-PARTY page, so this must list your site, not this server.
#   WIDGET_ALLOWED_ORIGINS=https://staging.yourcompany.com
# "*" is a dev default and should not survive to a real deployment.
WIDGET_ALLOWED_ORIGINS=*

# Where the widget's "Sign in for full AI support" button sends a guest.
# The WordPress plugin supplies this per-request via data-sign-in-url; this
# is the fallback for non-WordPress embeds.
WIDGET_SIGN_IN_URL=


# ── Backups ────────────────────────────────────────────────────────────

# Passphrase for UNATTENDED backups (cron). Archives are AES-256-GCM
# encrypted with a key derived from it.
#
# Think before putting a value here. If your backups are written to this same
# host, a passphrase in this file is a passphrase sitting next to the thing it
# protects — which buys nothing against anyone who reaches the server. It is
# worth setting when archives are shipped OFF the host (to a NAS, object
# storage, a different account), because then the file and the key really are
# in different places.
#
# Leave empty and the console and CLI prompt for a passphrase instead.
# LOSING IT LOSES THE BACKUP. There is no recovery path, by design.
BACKUP_PASSPHRASE=

# Set to 1 to permit unencrypted exports. Off by default: an archive holds
# staff password hashes and customer contact details.
BACKUP_ALLOW_PLAINTEXT=


# ── Ports ──────────────────────────────────────────────────────────────
BACKEND_PORT=8000
WIDGET_PORT=8081


# ── Model mode ─────────────────────────────────────────────────────────
# api = online provider (needs a key above). local = Ollama only.
GENERATION_MODE=api
ONLINE_PROVIDER=deepseek


# ── Limits ─────────────────────────────────────────────────────────────
# These are only the INITIAL values. Once running, they are editable in the
# console under Access & limits (root only) and take effect on the next
# request — see policy.py. Guest AI access is OFF unless switched on there.
QUOTA_MEMBER=25
QUOTA_STAFF=500
QUOTA_ANON_FAQ=60
QUOTA_ANON_IP=200
WIDGET_QUESTIONS_PER_SESSION=0
WIDGET_TOKENS_PER_SESSION=0
