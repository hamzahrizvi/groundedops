# Rename this file to  .env  and put it NEXT TO docker-compose.yml
# (i.e. at  C:\Users\hrizvi\Downloads\Git\groundedops\.env )
#
# docker-compose.yml already references these — you just supply the values.
# After creating/editing .env:   docker compose up -d backend
# Verify it landed:              docker compose exec backend printenv DEEPSEEK_API_KEY

DEEPSEEK_API_KEY=sk-your-real-deepseek-key-here

# Optional — only if you use these providers:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — force ingest to always use DeepSeek for FAQ generation:
INGEST_PROVIDER=deepseek
