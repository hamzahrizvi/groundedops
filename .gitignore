# ── Vector DB / Chroma ─────────────────────
src/chroma_db/
chroma_db/

# ── Binary / index files ───────────────────
*.bin
*.sqlite3
*.db

# ── Logs ──────────────────────────────────
logs.json
logs.jsonl
*.log
*.log.err

# ── Secrets ───────────────────────────────
.deepseek_key.json
.deepseek_key.enc
*.enc
.env
*.env
# run.ps1's summary of the last run — includes the member token and the
# widget secret. Never commit this.
handover.txt

# ── Python ────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Node / build output ───────────────────
# Both are regenerated: install.ps1/install.sh run `npm install && npm run build`,
# and docker/Dockerfile.frontend builds its own copy. docker/.dockerignore skips
# them too.
node_modules/
dist/

# ── OS / IDE ──────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

eval_results.json
# eval_baseline*.json is deliberately NOT ignored — eval.py diffs each run
# against the committed baseline (see eval.py:11).

corpus/*
!corpus/README.md

uploads/

# ── Obsidian notes vault (not part of the app) ─
GroundedOps-Vault/
.obsidian/

# ── Runtime data (regenerated on first write, see PROJECT_MAP.md) ──
faq_store.json
faq_gaps.json
gaps_store.json
catalog_config.json
ingest_stamp.txt
conversations.db
# widget_config.py is currently unwired (see PROJECT_MAP.md's BROKEN
# STATE note), but widget_leads.json in particular would hold customer
# contact details the moment it is — ignored ahead of that landing.
widget_config.json
widget_leads.json
